<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="ur5-robot">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />
    <!-- Fix: Added the use_sim -->
    <!-- <xacro:arg name="use_sim" default="false"/> -->

    <!-- Import ur5-robot urdf file -->
    <!-- <xacro:include filename="$(find husky_ur5_description)/urdf/ur5/ur5.urdf" /> -->

    <xacro:include filename="ur5_arm.urdf" />

    <!-- Import control_xacro -->
    <xacro:include filename="ur5-robot.ros2_control.xacro" />

<!-- Added use_sim="$(arg use_sim)"  use_sim="$(arg use_sim)"-->
    <xacro:ur5-robot_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>

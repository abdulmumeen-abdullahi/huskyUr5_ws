<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="ur5-robot">
    <xacro:arg name="initial_positions_file" default="$(find ur5_moveit_config)/config/initial_positions.yaml" />

    <xacro:include filename="$(find ur5_moveit_config)/config/ur5_arm.urdf" />
    <xacro:include filename="$(find ur5_moveit_config)/config/ur5-robot.ros2_control.xacro" />

    <xacro:ur5-robot_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>
</robot>
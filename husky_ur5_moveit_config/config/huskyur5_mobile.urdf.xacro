<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="huskyur5_mobile">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import huskyur5_mobile urdf file -->
    <!-- <xacro:include filename="$(find husky_ur5_description)/urdf/huskyur5.urdf" /> -->
    <xacro:include filename="husky_ur5.urdf" />

    <!-- Import control_xacro -->
    <xacro:include filename="huskyur5_mobile.ros2_control.xacro" />


    <xacro:huskyur5_mobile_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>

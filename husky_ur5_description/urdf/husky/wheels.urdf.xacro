<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- Shared Wheel Properties -->
  <xacro:property name="wheel_radius" value="0.1651" />
  <xacro:property name="wheel_mass" value="2.637" />
  <xacro:property name="wheel_width" value="0.1143" />

  <!-- Single Parametrized Wheel Macro -->
  <xacro:macro name="a200_wheel" params="prefix type *joint_pose">
    <link name="${prefix}_wheel_link">
      <inertial>
        <mass value="${wheel_mass}" />
        <origin xyz="0 0 0" />
        <inertia
          ixx="${ wheel_mass/12 * (3*wheel_radius**2 + wheel_width**2) }" ixy="0" ixz="0"
          iyy="${ wheel_mass/2 * wheel_radius**2 }" iyz="0"
          izz="${ wheel_mass/12 * (3*wheel_radius**2 + wheel_width**2) }" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <!-- Automatically selects the indoor or outdoor mesh based on the 'type' parameter -->
          <mesh filename="package://husky_ur5_description/meshes/husky/${type}.dae" />
        </geometry>
        <material name="dark_grey" />
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${M_PI/2} 0 0" />
        <geometry>
          <cylinder length="${wheel_width}" radius="${wheel_radius}" />
        </geometry>
      </collision>
    </link>

    <!-- Gazebo Wheel Slip Plugin -->
    <gazebo>
      <plugin filename="libgz-sim-wheel-slip-system.so" name="gz::sim::systems::WheelSlip">
        <wheel link_name="${prefix}_wheel_link">
          <slip_compliance_lateral>1.0</slip_compliance_lateral>
          <slip_compliance_longitudinal>1.0</slip_compliance_longitudinal>
          <wheel_normal_force>113</wheel_normal_force>
          <wheel_radius>${wheel_radius}</wheel_radius>
        </wheel>
      </plugin>
    </gazebo>

    <!-- Wheel Joint -->
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel_link"/>
      <xacro:insert_block name="joint_pose"/>
      <axis xyz="0 1 0" rpy="0 0 0" />
    </joint>
  </xacro:macro>

  <!-- The Main Drivetrain Spawner -->
  <xacro:macro name="a200_drivetrain_wheels" params="front_wheels rear_wheels wheel_base wheel_track">
    <!-- Export the radius for other files (like the footprint z-offset) to use -->
    <xacro:property name="front_wheel_radius" value="${wheel_radius}" scope="parent"/>

    <!-- Front Left -->
    <xacro:a200_wheel prefix="front_left" type="${front_wheels}">
      <origin xyz="${wheel_base/2} ${wheel_track/2} 0" rpy="0 0 0"/>
    </xacro:a200_wheel>

    <!-- Front Right -->
    <xacro:a200_wheel prefix="front_right" type="${front_wheels}">
      <origin xyz="${wheel_base/2} ${-wheel_track/2} 0" rpy="0 0 0"/>
    </xacro:a200_wheel>

    <!-- Rear Left -->
    <xacro:a200_wheel prefix="rear_left" type="${rear_wheels}">
      <origin xyz="${-wheel_base/2} ${wheel_track/2} 0" rpy="0 0 0"/>
    </xacro:a200_wheel>

    <!-- Rear Right -->
    <xacro:a200_wheel prefix="rear_right" type="${rear_wheels}">
      <origin xyz="${-wheel_base/2} ${-wheel_track/2} 0" rpy="0 0 0"/>
    </xacro:a200_wheel>
  </xacro:macro>

</robot>
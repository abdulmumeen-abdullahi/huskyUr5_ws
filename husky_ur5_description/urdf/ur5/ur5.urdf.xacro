<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="ur5-robot">
  <xacro:arg name="sim_gazebo" default="false"/>

  <!-- Load common definitions -->
  <xacro:include filename="macros.xacro"/>
  <xacro:include filename="links.xacro"/>
  <xacro:include filename="joints.xacro"/>
  <xacro:include filename="ros2_control.xacro"/>
  <xacro:property name="gazebo_control" value="true" />


  <xacro:arg name="ur5_standalone" default="true"/>
  <xacro:if value="$(arg ur5_standalone)">
    <link name="base_link"/>
    <joint name="standalone_base_joint" type="fixed">
      <parent link="base_link"/>
      <child link="ur5_base_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <link name="world"/>
    <joint name="world_to_base" type="fixed">
      <parent link="world"/>
      <child link="base_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>
  </xacro:if>

</robot>
<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="huskyur5_mobile">

  <!-- GLOBAL ARGUMENTS & PROPERTIES -->
  <!-- Fix: Only load a single plugin when UR5 is mounted on Husky to deduplicate plugins -->
  <xacro:arg name="husky_standalone" default="false"/>
  <xacro:arg name="ur5_standalone" default="false"/>

  <!-- Include the Husky base and material -->
  <xacro:include filename="$(find husky_ur5_description)/urdf/husky/husky_a200.urdf.xacro" />

  <!-- Include the UR5 arm -->
  <xacro:include filename="$(find husky_ur5_description)/urdf/ur5/ur5.urdf.xacro" />

  <!-- Include Custom Integration Links & Joints -->
  <xacro:include filename="$(find husky_ur5_description)/urdf/links.xacro" />
  <xacro:include filename="$(find husky_ur5_description)/urdf/joints.xacro" />

  <!-- Single Unified Gazebo ROS 2 Control Plugin -->
  <xacro:if value="$(arg is_sim)">
    <gazebo>
      <plugin filename="libgz_ros2_control-system.so" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>$(arg gazebo_controllers)</parameters>
        <parameters>$(find ur5_moveit_config)/config/ros2_controllers.yaml</parameters>
        <ros>
          <remapping>~/odom:=platform/odom</remapping>
          <remapping>~/cmd_vel:=platform/cmd_vel</remapping>
          <remapping>/tf:=tf</remapping>
          <remapping>/tf_static:=tf_static</remapping>
          <remapping>/diagnostics:=diagnostics</remapping>
          <remapping>/dynamic_joint_states:=platform/dynamic_joint_states</remapping>
          <remapping>joint_states:=platform/joint_states</remapping>
          <remapping>~/reference:=platform/cmd_vel</remapping>
          <remapping>~/odometry:=platform/odom</remapping>
          <namespace>$(arg namespace)</namespace>
        </ros>
      </plugin>
    </gazebo>
  </xacro:if>

</robot>